DISCORD_TOKEN=your_discord_token_here
MEDIA_PATH=/home/youruser/path/to/your/content
# Optional: prefix for organized file names (default: none).
# The prefix is normalised: leading/trailing underscores are trimmed,
# runs of underscores are collapsed, whitespace becomes underscores, and
# invalid filename characters are stripped. A single "_" separator is
# added automatically between the prefix and the UUID.
# MEDIA_NAME_PREFIX=grub
# Optional: your host user/group IDs to avoid permission issues
# UID=1000
# GID=1000

# Optional: Discord upload limit in MB (default: 10). Raise it if your account
# or server allows more (Nitro / boosted server). Used as the heavy/ threshold
# and the size gate — files over the limit never get their quality squeezed,
# they simply stay in heavy/ for manual upload.
# MAX_FILE_SIZE_MB=10

# Optional: video encode knobs (ffmpeg watermarking).
# VIDEO_CRF: lower = better quality / larger file. Sensible range 18-23.
# VIDEO_PRESET: faster presets = far less CPU/heat at the cost of some extra
# compression efficiency (default). fast/medium/slow/veryslow available.
# VIDEO_FFMPEG_TIMEOUT_MS: base timeout per video encode (default 120000);
# it scales automatically with the video length (capped at 6h), so long files
# are never killed mid-encode.
# VIDEO_ENCODER: video encode backend (default auto). auto picks the first
# usable encoder at boot: qsv → vaapi → nvenc → amf → libx264 (software last).
# Force one: qsv | vaapi | nvenc | amf | libx264. Hardware encoders offload the
# H.264 encode to the GPU/iGPU (less CPU, heat and wall time); if the hardware
# attempt fails at encode time the pipeline retries with libx264 automatically.
# VIDEO_FFMPEG_THREADS: cap for libx264 worker threads (default 0 = ffmpeg
# decides). Hardware encoders ignore it (threading lives on the iGPU/GPU).
# VIDEO_NICE=1: Linux only, run ffmpeg at nice -n 10 so watermarking never
# starves the system (slightly slower, far calmer fans).
# SHARP_CONCURRENCY: image watermarking worker pool (default 4). Raise it on
# well-cooled machines for more throughput.
# VIDEO_CRF=20
# VIDEO_PRESET=fast
# VIDEO_FFMPEG_TIMEOUT_MS=120000
# VIDEO_ENCODER=auto
# VIDEO_FFMPEG_THREADS=0
# VIDEO_NICE=1
# SHARP_CONCURRENCY=4

# Optional: per-folder file progress counter [i/total] in the console.
# Shown before every file in both the normal upload pipeline and the heavy
# processing mode. Set to 0 to disable and get quieter logs (default: enabled).
# SHOW_FILE_PROGRESS=1
