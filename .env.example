DISCORD_TOKEN=your_discord_token_here
MEDIA_PATH=/home/youruser/path/to/your/content
# Optional: prefix for organized file names (default: none).
# The prefix is normalised: leading/trailing underscores are trimmed,
# runs of underscores are collapsed, whitespace becomes underscores, and
# invalid filename characters are stripped. A single "_" separator is
# added automatically between the prefix and the UUID.
# MEDIA_NAME_PREFIX=grub
# Optional: your host user/group IDs to avoid permission issues
# UID=1000
# GID=1000

# Optional: Discord upload limit in MB (default: 10). Raise it if your account
# or server allows more (Nitro / boosted server). Used for the heavy/ threshold,
# the size gate and the video encode budget.
# MAX_FILE_SIZE_MB=10

# Optional: video encode knobs (ffmpeg watermarking).
# VIDEO_CRF: lower = better quality / larger file. Sensible range 18-23.
# VIDEO_PRESET: slower = better compression, more CPU time (fast/medium/slow/veryslow).
# VIDEO_FFMPEG_TIMEOUT_MS: timeout per video encode (default 120000).
# VIDEO_CRF=20
# VIDEO_PRESET=slow
# VIDEO_FFMPEG_TIMEOUT_MS=120000
